# Sentinel gateway configuration. Keep real credentials in .env only.
SENTINEL_CATALOGUE_URL=
SENTINEL_API_TOKEN=
SENTINEL_USERNAME=
SENTINEL_PASSWORD=
SENTINEL_VERIFY_TLS=true
SENTINEL_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SENTINEL_DATABASE_URL=sqlite:///./data/sentinel.db
SENTINEL_USE_GPU=true
SENTINEL_INFERENCE_SAMPLE_FPS=3.0
SENTINEL_MAPTILER_KEY=

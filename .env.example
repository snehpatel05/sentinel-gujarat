# Sentinel Gateway Configuration
# =================================
# Keep real credentials in .env only; never commit this file to Git.
# Copy this file to .env and fill in your values.

# Official Sentinel API Configuration
# Leave SENTINEL_CATALOGUE_URL blank for mock mode (4 seeded cameras)
# Set to http://HOST/api/ingest when organizers provide credentials
SENTINEL_CATALOGUE_URL=

# Authentication (Optional, depends on organizer's gateway)
SENTINEL_API_TOKEN=
SENTINEL_USERNAME=
SENTINEL_PASSWORD=

# TLS Certificate Verification
# Set to false ONLY if organizers document a development certificate
# and your team has explicitly approved the security risk
SENTINEL_VERIFY_TLS=true

# CORS Origins (Comma-separated for development and production)
# Development: http://localhost:5173 (Vite)
# Production: https://your-vercel-project.vercel.app
SENTINEL_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://sentinel-gujaratvercel.app

# Database Configuration
# SQLite path for camera catalogue, detection history, and alerts
SENTINEL_DATABASE_URL=sqlite:///./data/sentinel.db

# GPU Configuration
# Set to true for CUDA-accelerated YOLO, EasyOCR, and tracking
# Requires: PyTorch[cuda], ultralytics, easyocr, supervision
# Optional: Only needed when processing real RTSP streams
SENTINEL_USE_GPU=true

# Inference Settings
# Sample rate (FPS) for YOLO inference on real camera streams
# Lower = fewer detections but less GPU load
# Recommended: 2.0-5.0 FPS for real-time tracking
SENTINEL_INFERENCE_SAMPLE_FPS=3.0

# MapTiler API Key (Optional)
# For enhanced map tiles in the GIS dashboard
# Free tier: https://maptiler.com/cloud/
SENTINEL_MAPTILER_KEY=
